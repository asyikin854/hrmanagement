# Site-wide rules (Apache behind Plesk's nginx). Every block sits in IfModule, so a missing module can't break the site.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# One address for search engines: www goes to the main host
RewriteCond %{HTTP_HOST} ^www\.hrmanagement\.esrmy\.com$ [NC]
RewriteRule ^ https://hrmanagement.esrmy.com%{REQUEST_URI} [R=301,L]
# /index.html and /en/index.html go to their folder address
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
</IfModule>

# Project notes and build tools are in the repository, not for the web
<FilesMatch "\.(md|py)$">
Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always setifempty X-Frame-Options "SAMEORIGIN"
Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

# Browser caching. CSS and JS are kept short because their file names don't change between versions.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
ExpiresByType text/javascript "access plus 1 day"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
</IfModule>
